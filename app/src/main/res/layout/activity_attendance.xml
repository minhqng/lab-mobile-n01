<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/textAttendanceTitle"
            style="@style/TextAppearance.EmployeeManager.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cong_title" />

        <TextView
            android:id="@+id/textAttendanceDate"
            style="@style/TextAppearance.EmployeeManager.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/cong_date_label" />

        <TextView
            android:id="@+id/textAttendanceTime"
            style="@style/TextAppearance.EmployeeManager.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/cong_time_label" />

        <TextView
            android:id="@+id/textCheckInTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/cong_checkin_none" />

        <TextView
            android:id="@+id/textCheckOutTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/cong_checkout_none" />

        <TextView
            android:id="@+id/textAttendanceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/cong_status_open" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonCheckIn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cong_button_checkin" />

            <Button
                android:id="@+id/buttonCheckOut"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/cong_button_checkout" />
        </LinearLayout>

        <Button
            android:id="@+id/buttonWorkHistory"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/cong_button_history" />
    </LinearLayout>
</ScrollView>