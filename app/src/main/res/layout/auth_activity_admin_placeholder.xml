<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            style="@style/TextAppearance.EmployeeManager.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auth_admin_placeholder_title"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/primary_container"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="@string/auth_admin_placeholder_badge"
            android:textColor="@color/on_primary_container"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            style="@style/TextAppearance.EmployeeManager.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/auth_admin_placeholder_desc" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="@color/outline" />

        <!-- Card thông tin phiên -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auth_user_info_title"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/auth_admin_tv_account_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Mã tài khoản: -"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/auth_admin_tv_username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tên tài khoản: -"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/auth_admin_tv_role"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Vai trò: ADMIN"
                android:textSize="14sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/auth_admin_btn_logout"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:text="@string/auth_logout_button"
            android:textColor="@color/error" />

    </LinearLayout>
</ScrollView>
