<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="640dp"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/textTitle"
            style="@style/TextAppearance.EmployeeManager.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/main_title" />

        <TextView
            style="@style/TextAppearance.EmployeeManager.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/main_subtitle" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:background="@color/outline" />

        <TextView
            android:id="@+id/textFoundationReady"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary_container"
            android:padding="16dp"
            android:text="@string/main_checking_session"
            android:textColor="@color/on_primary_container"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            style="@style/TextAppearance.EmployeeManager.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/main_subtitle" />

        <TextView
            style="@style/TextAppearance.EmployeeManager.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/main_foundation_version"
            android:textSize="14sp" />

    </LinearLayout>

</ScrollView>
